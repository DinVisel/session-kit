# All NEXT_PUBLIC_* vars are optional. With nothing set, the demo runs fully
# offline: no wallet required, no chain writes, everything tagged "simulated".

# Base URL of an external relayer (e.g. the root api/server.ts on :3000).
# Leave unset to use this app's own local mock relayer at /api/relay-tx.
NEXT_PUBLIC_RELAYER_URL=

# Deployed SessionValidator address. Leave unset (or the zero address) to
# keep SessionKit in mock mode — no wallet popup, no chain write.
NEXT_PUBLIC_VALIDATOR_ADDRESS=

# API key sent as `x-api-key` to the relayer. Unused by the local mock relayer.
NEXT_PUBLIC_SESSIONKIT_API_KEY=

# Chain the "live" path targets. 11155111 = Sepolia.
NEXT_PUBLIC_CHAIN_ID=11155111

# --- Local mock relayer (playground/app/api/relay-tx/route.ts) only ---
# Server-side only (no NEXT_PUBLIC_ prefix — never exposed to the browser).
# Set both to let the local relayer actually broadcast; unset (the default)
# and it returns a simulated sponsored receipt instead.
SPONSOR_PRIVATE_KEY=
VALIDATOR_ADDRESS=
